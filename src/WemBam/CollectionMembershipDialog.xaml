<Window x:Class="WemBam.CollectionMembershipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collections"
        Width="350"
        Height="450"
        MinWidth="300"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
            Margin="0,0,0,8">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Collections"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                Content="+"
                Width="28"
                Height="24"
                Padding="0"
                ToolTip="New Collection"
                Click="NewCollectionButton_Click"/>
            </Grid>

            <TextBox Grid.Row="1"
             x:Name="CollectionFilterTextBox"
             Margin="0,8,0,0"
             Height="26"
             VerticalContentAlignment="Center"
             ToolTip="Filter collections"
             TextChanged="CollectionFilterTextBox_TextChanged"
             GotFocus="CollectionFilterTextBox_GotFocus"/>

        </Grid>

        <ListBox x:Name="CollectionsListBox"
                 Grid.Row="1"
                 SelectionMode="Multiple"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Apply"
                    Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="ApplyButton_Click"/>

            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True"/>

        </StackPanel>

    </Grid>

</Window>