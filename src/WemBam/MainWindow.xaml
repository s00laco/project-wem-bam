<Window x:Class="WemBam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wem Bam"
        Height="900"
        Width="1500"
        MinHeight="700"
        MinWidth="1100">

	<DockPanel>

		<!-- Top Menu -->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="Settings..."
                          Click="SettingsMenuItem_Click"/>
				<Separator/>
				<MenuItem Header="E_xit"/>
			</MenuItem>

			<MenuItem Header="_View"/>

			<MenuItem Header="_Help"/>
		</Menu>

		<!-- Status Bar -->
		<StatusBar DockPanel.Dock="Bottom">

			<StatusBar.ToolTip>
				<ToolTip x:Name="BackgroundTaskToolTip">
					<StackPanel>

						<TextBlock x:Name="StatusToolTipStatusText"/>

						<TextBlock x:Name="StatusToolTipItemsProcessedText"/>

						<TextBlock x:Name="StatusToolTipTotalItemsText"/>

						<TextBlock x:Name="StatusToolTipElapsedText"/>

					</StackPanel>
				</ToolTip>
			</StatusBar.ToolTip>

			<StatusBarItem>

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock x:Name="StatusTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Ready"/>

					<ProgressBar x:Name="BackgroundTaskProgressBar"
                                 Grid.Column="1"
                                 Height="16"
                                 Margin="12,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="False"
                                 Visibility="Collapsed"/>

					<TextBlock x:Name="PercentageTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Text=""
                               Visibility="Collapsed"/>

					<TextBlock x:Name="ElapsedTimeTextBlock"
                               Grid.Column="3"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text=""/>

				</Grid>

			</StatusBarItem>

		</StatusBar>

		<!-- Playback -->
		<Border DockPanel.Dock="Bottom"
                BorderBrush="#FFD8D8D8"
                BorderThickness="0,1,0,0"
                Padding="8">

			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="20"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="140"/>
				</Grid.ColumnDefinitions>

				<!-- Transport -->
				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

					<Button Content="Previous"
                            Margin="0,0,6,0"
                            MinWidth="75"/>

					<Button Content="Play / Pause"
                            Margin="0,0,6,0"
                            MinWidth="95"
                            Click="MainPlayPauseButton_Click"/>

					<Button Content="Next"
                            Margin="0,0,6,0"
                            MinWidth="60"/>

					<Button Content="Stop"
                            MinWidth="60"
                            Click="StopButton_Click"/>

				</StackPanel>

				<!-- Timeline -->
				<Slider Grid.Column="2"
                        VerticalAlignment="Center"/>

				<!-- Volume -->
				<TextBlock Grid.Column="4"
                           Text="Volume"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

				<Slider Grid.Column="5"
                        VerticalAlignment="Center"/>

			</Grid>

		</Border>

		<!-- Main Area -->
		<Grid Margin="8">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="4*"/>
				<ColumnDefinition Width="5"/>
				<ColumnDefinition Width="320"
                                  MinWidth="280"/>
			</Grid.ColumnDefinitions>

			<!-- Workspace -->
			<TabControl Grid.Column="0">

				<TabItem Header="Filter 1">

					<Grid Margin="6">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="250"
                                              MinWidth="200"/>
							<ColumnDefinition Width="5"/>
							<ColumnDefinition Width="*"
                                              MinWidth="450"/>
						</Grid.ColumnDefinitions>

						<!-- Collections -->
						<GroupBox Grid.Column="0"
                                  Header="Collections"
                                  Margin="0,0,6,0">

							<Grid Margin="6">

								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

                                <TreeView x:Name="CollectionsTreeView"
                                          Grid.Row="0"
                                          SelectedItemChanged="CollectionsTreeView_SelectedItemChanged">

                                    <TreeViewItem Header="All Sounds"/>

									<TreeViewItem Header="Favourites"/>

									<TreeViewItem Header="Collections">
										<TreeViewItem Header="Example Collection"/>
									</TreeViewItem>

								</TreeView>

								<StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">

									<Button Content="New"
                                            Width="70"
                                            Click="NewCollectionButton_Click"/>

									<Button Content="Rename"
                                            Width="75"
                                            Margin="6,0,0,0"
                                            Click="RenameCollectionButton_Click"/>  

									<Button Content="Delete"
                                            Width="70"
                                            Margin="6,0,0,0"
                                            Click="DeleteCollectionButton_Click"/>

								</StackPanel>

							</Grid>

						</GroupBox>

						<!-- Splitter -->
						<GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ShowsPreview="True"
                                      ResizeBehavior="PreviousAndNext"/>

						<!-- Results -->
						<Grid Grid.Column="2"
                              Margin="6,0,0,0">

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="8"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<!-- Filter -->
                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Content="Filter"
                                       VerticalAlignment="Center"
                                       Padding="0"/>

                                <TextBox x:Name="FilterTextBox"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         MinWidth="150"
                                         KeyDown="FilterTextBox_KeyDown"/>

                                <Button x:Name="SearchButton"
                                        Grid.Column="4"
                                        Content="Search"
                                        Width="80"
                                        Click="SearchButton_Click"/>

                            </Grid>

                            <!-- Results -->
                            <DataGrid x:Name="ResultsDataGrid"
                                      Grid.Row="2"
                                      MinWidth="450"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      SelectionChanged="ResultsDataGrid_SelectionChanged">

                                <DataGrid.Resources>

                                    <Style TargetType="ScrollBar">

                                        <Setter Property="Width"
                                                Value="8"/>

                                        <Setter Property="Template">

                                            <Setter.Value>

                                                <ControlTemplate TargetType="ScrollBar">

                                                    <Grid Background="Transparent">

                                                        <Track
                                                            x:Name="PART_Track"
                                                            Focusable="False"
                                                            IsDirectionReversed="True"
                                                            Width="6"
                                                            HorizontalAlignment="Center">

                                                            <Track.DecreaseRepeatButton>

                                                                <RepeatButton
                                                                    x:Name="DecreaseButton"
                                                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Opacity="0"/>

                                                            </Track.DecreaseRepeatButton>

                                                            <Track.Thumb>

                                                                <Thumb
                                                                    x:Name="Thumb"
                                                                    Width="6"
                                                                    Background="#808080"
                                                                    BorderThickness="0"
                                                                    Opacity="0.8"
                                                                    HorizontalAlignment="Center">

                                                                    <Thumb.Template>

                                                                        <ControlTemplate TargetType="Thumb">

                                                                            <Border
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="3"/>

                                                                        </ControlTemplate>

                                                                    </Thumb.Template>

                                                                </Thumb>

                                                            </Track.Thumb>

                                                            <Track.IncreaseRepeatButton>

                                                                <RepeatButton
                                                                    x:Name="IncreaseButton"
                                                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Opacity="0"/>

                                                            </Track.IncreaseRepeatButton>

                                                        </Track>

                                                    </Grid>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger
                                                            Property="Orientation"
                                                            Value="Vertical">

                                                            <Setter
                                                                TargetName="PART_Track"
                                                                Property="Orientation"
                                                                Value="Vertical"/>

                                                            <Setter
                                                                TargetName="DecreaseButton"
                                                                Property="Command"
                                                                Value="ScrollBar.LineUpCommand"/>

                                                            <Setter
                                                                TargetName="IncreaseButton"
                                                                Property="Command"
                                                                Value="ScrollBar.LineDownCommand"/>

                                                        </Trigger>

                                                        <Trigger
                                                            Property="Orientation"
                                                            Value="Horizontal">

                                                            <Setter
                                                                TargetName="PART_Track"
                                                                Property="Orientation"
                                                                Value="Horizontal"/>

                                                            <Setter
                                                                TargetName="DecreaseButton"
                                                                Property="Command"
                                                                Value="ScrollBar.LineLeftCommand"/>

                                                            <Setter
                                                                TargetName="IncreaseButton"
                                                                Property="Command"
                                                                Value="ScrollBar.LineRightCommand"/>

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Setter.Value>

                                        </Setter>

                                    </Style>

                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                     Color="#a0a0a0"/>

                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                     Color="White"/>

                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                     Color="#a0a0a0"/>

                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                                     Color="White"/>

                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn
                                        Header=""
                                        Width="64">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                    <Button
                                                        Width="34"
                                                        Height="28"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Content="⋮"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Click="CollectionsButton_Click"
                                                        ToolTip="Collections..."/>

                                                    <Button
                                                        Width="28"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Click="PlayButton_Click">

                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="▶"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Content" Value="Ⅱ"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>

                                                    </Button>

                                                </StackPanel>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Filename"
                                                            Width="1*">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <TextBox
                                                    Text="{Binding FileName}"
                                                    IsReadOnly="True"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Padding="0"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Hidden"
                                                    IsTabStop="False">

                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">

                                                            <Setter Property="Foreground"
                                                                    Value="Black"/>

                                                            <Setter Property="FontWeight"
                                                                    Value="Normal"/>

                                                            <Style.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                    Value="True">

                                                                    <Setter Property="Foreground"
                                                                            Value="White"/>

                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>
                                                    </TextBox.Style>

                                                </TextBox>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn
                                        Header="Duration"
                                        Width="55"
                                        Binding="{Binding DurationText}"/>

                                    <DataGridTemplateColumn Header="Wwise Path"
                                                            Width="4*">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <TextBox
                                                    Text="{Binding WwisePath}"
                                                    IsReadOnly="True"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Padding="0"
                                                    HorizontalScrollBarVisibility="Hidden"
                                                    VerticalScrollBarVisibility="Hidden"
                                                    IsTabStop="False">

                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">

                                                            <Setter Property="Foreground"
                                                                    Value="Black"/>

                                                            <Setter Property="FontWeight"
                                                                    Value="Normal"/>

                                                            <Style.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                    Value="True">

                                                                    <Setter Property="Foreground"
                                                                            Value="White"/>

                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>
                                                    </TextBox.Style>

                                                </TextBox>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Wwise Events"
                                                            Width="2*">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <Grid>

                                                    <!-- Normal display for 1–5 events -->
                                                    <ItemsControl
                                                        x:Name="NormalEventList"
                                                        ItemsSource="{Binding WwiseEvents}">

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBox
                                                                    Text="{Binding Mode=OneWay}"
                                                                    IsReadOnly="True"
                                                                    BorderThickness="0"
                                                                    Background="Transparent"
                                                                    Padding="0"
                                                                    Margin="0,1,0,1"
                                                                    HorizontalScrollBarVisibility="Hidden"
                                                                    VerticalScrollBarVisibility="Hidden"
                                                                    IsTabStop="False">

                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">

                                                                            <Setter Property="Foreground"
                                                                                    Value="Black"/>

                                                                            <Setter Property="FontWeight"
                                                                                    Value="Normal"/>

                                                                            <Style.Triggers>

                                                                                <DataTrigger
                                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                                    Value="True">

                                                                                    <Setter Property="Foreground"
                                                                                            Value="White"/>

                                                                                    <Setter Property="FontWeight"
                                                                                            Value="SemiBold"/>

                                                                                </DataTrigger>

                                                                            </Style.Triggers>

                                                                        </Style>
                                                                    </TextBox.Style>

                                                                </TextBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                    <!-- Expandable display for 6+ events -->
                                                    <Expander
                                                        x:Name="ExpandedEventList"
                                                        Visibility="Collapsed">

                                                        <Expander.Style>
                                                            <Style TargetType="Expander">

                                                                <Setter Property="Template">
                                                                    <Setter.Value>

                                                                        <ControlTemplate TargetType="Expander">

                                                                            <Grid>

                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="*"/>
                                                                                </Grid.RowDefinitions>

                                                                                <!-- Header / chevron -->
                                                                                <ToggleButton
                                                                                    x:Name="HeaderSite"
                                                                                    Grid.Row="0"
                                                                                    IsChecked="{Binding IsExpanded,
                                                                                                        RelativeSource={RelativeSource TemplatedParent},
                                                                                                        Mode=TwoWay}"
                                                                                    Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    Padding="0"
                                                                                    FocusVisualStyle="{x:Null}"
                                                                                    HorizontalContentAlignment="Stretch">

                                                                                    <ToggleButton.Template>
                                                                                        <ControlTemplate TargetType="ToggleButton">

                                                                                            <Border
                                                                                                Background="{TemplateBinding Background}"
                                                                                                Padding="{TemplateBinding Padding}">

                                                                                                <ContentPresenter/>

                                                                                            </Border>

                                                                                        </ControlTemplate>
                                                                                    </ToggleButton.Template>

                                                                                    <Grid>

                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="20"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <TextBlock
                                                                                            x:Name="Chevron"
                                                                                            Grid.Column="0"
                                                                                            Text="^"
                                                                                            FontSize="14"
                                                                                            FontWeight="SemiBold"
                                                                                            Foreground="Black"
                                                                                            VerticalAlignment="Top"
                                                                                            HorizontalAlignment="Center"
                                                                                            Margin="0,0,2,0"/>

                                                                                        <ContentPresenter
                                                                                            Grid.Column="1"
                                                                                            Content="{TemplateBinding Header}"
                                                                                            VerticalAlignment="Center"/>

                                                                                    </Grid>

                                                                                </ToggleButton>

                                                                                <!-- Expanded full Event list -->
                                                                                <ContentPresenter
                                                                                    x:Name="ExpandSite"
                                                                                    Grid.Row="1"
                                                                                    Content="{TemplateBinding Content}"
                                                                                    Margin="20,0,0,0"
                                                                                    Visibility="Collapsed"/>

                                                                            </Grid>

                                                                            <ControlTemplate.Triggers>

                                                                                <DataTrigger
                                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                                    Value="True">

                                                                                    <Setter
                                                                                        TargetName="Chevron"
                                                                                        Property="Foreground"
                                                                                        Value="White"/>

                                                                                </DataTrigger>

                                                                                <Trigger
                                                                                    Property="IsExpanded"
                                                                                    Value="True">

                                                                                    <Setter
                                                                                        TargetName="ExpandSite"
                                                                                        Property="Visibility"
                                                                                        Value="Visible"/>

                                                                                    <Setter
                                                                                        TargetName="Chevron"
                                                                                        Property="Text"
                                                                                        Value="⌄"/>

                                                                                    <Setter
                                                                                        TargetName="Chevron"
                                                                                        Property="FontSize"
                                                                                        Value="12"/>

                                                                                </Trigger>

                                                                            </ControlTemplate.Triggers>

                                                                        </ControlTemplate>

                                                                    </Setter.Value>
                                                                </Setter>

                                                            </Style>
                                                        </Expander.Style>

                                                        <Expander.Header>

                                                            <StackPanel
                                                                x:Name="CollapsedEventSummary">

                                                                <TextBlock
                                                                    Text="{Binding VisibleWwiseEventsText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground"
                                                                                    Value="Black"/>

                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                                    Value="True">

                                                                                    <Setter Property="Foreground"
                                                                                            Value="White"/>

                                                                                    <Setter Property="FontWeight"
                                                                                            Value="SemiBold"/>

                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock
                                                                    Text="{Binding AdditionalWwiseEvents.Count, StringFormat=+ {0} more}"
                                                                    FontStyle="Italic">

                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground"
                                                                                    Value="Black"/>

                                                                            <Style.Triggers>
                                                                                <DataTrigger
                                                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                                    Value="True">

                                                                                    <Setter Property="Foreground"
                                                                                            Value="White"/>

                                                                                    <Setter Property="FontWeight"
                                                                                            Value="SemiBold"/>

                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>

                                                                </TextBlock>

                                                            </StackPanel>

                                                        </Expander.Header>

                                                        <ScrollViewer
                                                            MaxHeight="200"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalScrollBarVisibility="Disabled">

                                                            <ScrollViewer.Resources>

                                                                <Style TargetType="ScrollBar">

                                                                    <Setter Property="Width"
                                                                            Value="8"/>

                                                                    <Setter Property="Template">

                                                                        <Setter.Value>

                                                                            <ControlTemplate TargetType="ScrollBar">

                                                                                <Grid Background="Transparent">

                                                                                    <Track
                                                                                        x:Name="PART_Track"
                                                                                        Focusable="False"
                                                                                        IsDirectionReversed="True"
                                                                                        Width="6"
                                                                                        HorizontalAlignment="Center">

                                                                                        <Track.DecreaseRepeatButton>

                                                                                            <RepeatButton
                                                                                                x:Name="DecreaseButton"
                                                                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                                                Background="Transparent"
                                                                                                BorderThickness="0"
                                                                                                Opacity="0"/>

                                                                                        </Track.DecreaseRepeatButton>

                                                                                        <Track.Thumb>

                                                                                            <Thumb
                                                                                                x:Name="Thumb"
                                                                                                Width="6"
                                                                                                Background="#808080"
                                                                                                BorderThickness="0"
                                                                                                Opacity="0.8"
                                                                                                HorizontalAlignment="Center">

                                                                                                <Thumb.Template>

                                                                                                    <ControlTemplate TargetType="Thumb">

                                                                                                        <Border
                                                                                                            Background="{TemplateBinding Background}"
                                                                                                            CornerRadius="3"/>

                                                                                                    </ControlTemplate>

                                                                                                </Thumb.Template>

                                                                                            </Thumb>

                                                                                        </Track.Thumb>

                                                                                        <Track.IncreaseRepeatButton>

                                                                                            <RepeatButton
                                                                                                x:Name="IncreaseButton"
                                                                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                                                Background="Transparent"
                                                                                                BorderThickness="0"
                                                                                                Opacity="0"/>

                                                                                        </Track.IncreaseRepeatButton>

                                                                                    </Track>

                                                                                </Grid>

                                                                                <ControlTemplate.Triggers>

                                                                                    <Trigger
                                                                                        Property="Orientation"
                                                                                        Value="Vertical">

                                                                                        <Setter
                                                                                            TargetName="PART_Track"
                                                                                            Property="Orientation"
                                                                                            Value="Vertical"/>

                                                                                        <Setter
                                                                                            TargetName="DecreaseButton"
                                                                                            Property="Command"
                                                                                            Value="ScrollBar.LineUpCommand"/>

                                                                                        <Setter
                                                                                            TargetName="IncreaseButton"
                                                                                            Property="Command"
                                                                                            Value="ScrollBar.LineDownCommand"/>

                                                                                    </Trigger>

                                                                                    <Trigger
                                                                                        Property="Orientation"
                                                                                        Value="Horizontal">

                                                                                        <Setter
                                                                                            TargetName="PART_Track"
                                                                                            Property="Orientation"
                                                                                            Value="Horizontal"/>

                                                                                        <Setter
                                                                                            TargetName="DecreaseButton"
                                                                                            Property="Command"
                                                                                            Value="ScrollBar.LineLeftCommand"/>

                                                                                        <Setter
                                                                                            TargetName="IncreaseButton"
                                                                                            Property="Command"
                                                                                            Value="ScrollBar.LineRightCommand"/>

                                                                                    </Trigger>

                                                                                </ControlTemplate.Triggers>

                                                                            </ControlTemplate>

                                                                        </Setter.Value>

                                                                    </Setter>

                                                                </Style>

                                                            </ScrollViewer.Resources>

                                                            <ItemsControl
                                                                ItemsSource="{Binding WwiseEvents}">

                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>

                                                                        <TextBox
                                                                            Text="{Binding Mode=OneWay}"
                                                                            IsReadOnly="True"
                                                                            BorderThickness="0"
                                                                            Background="Transparent"
                                                                            Padding="0"
                                                                            Margin="0,1,0,1"
                                                                            HorizontalScrollBarVisibility="Hidden"
                                                                            VerticalScrollBarVisibility="Hidden"
                                                                            IsTabStop="False">

                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox">

                                                                                    <Setter Property="Foreground"
                                                                                            Value="Black"/>

                                                                                    <Setter Property="FontWeight"
                                                                                            Value="Normal"/>

                                                                                    <Style.Triggers>

                                                                                        <DataTrigger
                                                                                            Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                                            Value="True">

                                                                                            <Setter Property="Foreground"
                                                                                                    Value="White"/>

                                                                                            <Setter Property="FontWeight"
                                                                                                    Value="SemiBold"/>

                                                                                        </DataTrigger>

                                                                                    </Style.Triggers>

                                                                                </Style>
                                                                            </TextBox.Style>

                                                                        </TextBox>

                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>

                                                            </ItemsControl>

                                                        </ScrollViewer>

                                                    </Expander>

                                                </Grid>

                                                <DataTemplate.Triggers>

                                                    <!-- 6+ events: use the expandable version -->
                                                    <DataTrigger
                                                        Binding="{Binding HasAdditionalWwiseEvents}"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="NormalEventList"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>

                                                        <Setter
                                                            TargetName="ExpandedEventList"
                                                            Property="Visibility"
                                                            Value="Visible"/>

                                                    </DataTrigger>

                                                    <!-- When expanded, hide the five-event preview -->
                                                    <DataTrigger
                                                        Binding="{Binding ElementName=ExpandedEventList, Path=IsExpanded}"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="CollapsedEventSummary"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>

                                                    </DataTrigger>

                                                </DataTemplate.Triggers>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

							</DataGrid>

						</Grid>

					</Grid>

				</TabItem>

				<TabItem Header="+"/>

			</TabControl>

			<!-- Main Splitter -->
			<GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"/>

			<!-- Details -->
            <GroupBox Grid.Column="2"
              Header="Selected Sound"
              Margin="5">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="10">

                        <TextBlock Text="Filename"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedFilenameTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,1,0,8"
                            Padding="0"/>

                        <TextBlock Text="Duration"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedDurationTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,1,0,8"
                            Padding="0"/>

                        <TextBlock Text="Looped"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedLoopedTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Margin="0,1,0,8"
                            Padding="0"/>

                        <Separator Margin="0,2,0,8"/>

                        <TextBlock Text="WEM Path"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedWwisePathTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Auto"
                            Margin="0,1,0,8"
                            Padding="0"/>

                        <TextBlock Text="Default Source — Container Path"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedContainerPathTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Auto"
                            Margin="0,1,0,8"
                            Padding="0"/>

                        <TextBlock Text="Default Source — Asset Path"
                            FontWeight="SemiBold"/>

                        <TextBox x:Name="SelectedAssetPathTextBox"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Auto"
                            Margin="0,1,0,10"
                            Padding="0"/>

                        <Separator Margin="0,2,0,8"/>

                        <TextBlock Text="Classes"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>

                        <ListBox x:Name="SelectedCategoriesListBox"
                            Height="100">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0"
                                        Margin="0,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Separator Margin="0,8"/>

                        <TextBlock Text="Wwise Events"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>

                        <ListBox x:Name="SelectedWwiseEventsListBox"
                            Height="180">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,6">

                                        <TextBox Text="{Binding Name}"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Padding="0"/>

                                        <TextBox Text="{Binding DurationType, StringFormat=Duration Type: {0}}"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Margin="0,2,0,0"
                                            Padding="0"/>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBox Text="{Binding DurationMin, StringFormat=Min: {0}}"
                                                IsReadOnly="True"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Padding="0"/>

                                            <TextBlock Text="    "/>

                                            <TextBox Text="{Binding DurationMax, StringFormat=Max: {0}}"
                                                IsReadOnly="True"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Padding="0"/>

                                        </StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Separator Margin="0,8"/>

                        <TextBlock Text="Tags"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>

                        <ListBox Height="100"/>

                        <Separator Margin="0,8"/>

                        <TextBlock Text="Notes"
                            FontWeight="SemiBold"
                            Margin="0,0,0,4"/>

                        <TextBox Height="180"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </ScrollViewer>

            </GroupBox>

        </Grid>

	</DockPanel>

</Window>